{
  "name": "macscreen-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "html-validate dist/index.html dist/404.html",
    "a11y": "node scripts/a11y.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "verify": "npm run check && npm run build && npm run validate && npm run a11y"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "html-validate": "^11.21.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
