---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

interface Props { version: string; dmgUrl: string }
const { version, dmgUrl } = Astro.props;
const links = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#privacy', label: 'Privacy' },
  { href: '#compare', label: 'Compare' },
  { href: '#install', label: 'Install' },
  { href: '#faq', label: 'FAQ' },
];
---
<header class="nav">
  <div class="container nav__bar">
    <a class="nav__brand" href="#top" aria-label={`${site.name} home`}>
      <Logo /><span>{site.name}</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={site.repoUrl} rel="noopener">GitHub</a>
    </nav>
    <div class="nav__actions">
      <ThemeToggle />
      <a class="btn btn--primary btn--small nav__cta" href={dmgUrl} aria-label={`Download MacScreen ${version}`}>Download</a>
      <details class="nav__menu">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <div class="nav__sheet">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={site.repoUrl} rel="noopener">GitHub</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50; height: var(--nav-h);
    background: var(--nav-bg); border-bottom: 1px solid var(--border);
    backdrop-filter: saturate(180%) blur(18px); -webkit-backdrop-filter: saturate(180%) blur(18px);
  }
  .nav__bar { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); }
  .nav__brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text); text-decoration: none; }
  .nav__links { display: none; gap: var(--space-5); }
  .nav__links a, .nav__sheet a { color: var(--muted); text-decoration: none; font-size: var(--step--1); font-weight: 500; transition: color var(--dur-base); }
  .nav__links a:hover, .nav__sheet a:hover { color: var(--text); }
  .nav__actions { display: flex; align-items: center; gap: var(--space-3); }

  .nav__menu { position: relative; }
  .nav__menu summary {
    list-style: none; display: grid; place-content: center; gap: 6px; width: 2.5rem; height: 2.5rem; cursor: pointer;
    border-radius: 50%; border: 1px solid var(--border);
  }
  .nav__menu summary::-webkit-details-marker { display: none; }
  .nav__menu summary span { display: block; width: 16px; height: 1.5px; background: var(--text); transition: transform var(--dur-base) var(--ease-out); }
  .nav__menu[open] summary span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav__menu[open] summary span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .nav__sheet {
    position: absolute; right: 0; top: calc(100% + 0.75rem); min-width: 12rem; display: grid; gap: 0.25rem; padding: var(--space-3);
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-m); box-shadow: var(--shadow-m);
  }
  .nav__sheet a { padding: 0.6rem 0.75rem; border-radius: var(--radius-s); font-size: var(--step-0); }
  .nav__sheet a:hover { background: var(--accent-soft); }

  @media (min-width: 52rem) {
    .nav__links { display: flex; }
    .nav__menu { display: none; }
  }
  @media (max-width: 26rem) { .nav__brand span { display: none; } }
</style>
