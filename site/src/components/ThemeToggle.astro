---
<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch theme">
  <svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6" />
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.2 14.6A8.2 8.2 0 0 1 9.4 3.8a8.2 8.2 0 1 0 10.8 10.8Z" />
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative; display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
    border-radius: 50%; border: 1px solid var(--border); background: transparent; color: var(--text); cursor: pointer;
    transition: background var(--dur-base), transform var(--dur-base) var(--ease-out);
  }
  .theme-toggle:hover { background: var(--accent-soft); }
  .theme-toggle:active { transform: scale(0.92); }
  .theme-toggle svg { grid-area: 1 / 1; transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur-base); }
  /* Show the icon of the theme you would switch to. */
  .moon { opacity: 1; transform: rotate(0) scale(1); }
  .sun { opacity: 0; transform: rotate(-60deg) scale(0.5); }
  :global(:root[data-theme='dark']) .moon { opacity: 0; transform: rotate(60deg) scale(0.5); }
  :global(:root[data-theme='dark']) .sun { opacity: 1; transform: rotate(0) scale(1); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon { opacity: 0; transform: rotate(60deg) scale(0.5); }
    :global(:root:not([data-theme='light'])) .sun { opacity: 1; transform: rotate(0) scale(1); }
  }
</style>
