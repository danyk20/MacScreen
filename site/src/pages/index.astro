---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { site } from '../data/site';
import { getLatestRelease } from '../data/release';

const latest = await getLatestRelease();
---
<Base>
  <Nav version={latest.version} dmgUrl={latest.dmgUrl} />
  <main id="main">
    <section class="hero" id="top">
      <div class="container hero__inner">
        <span class="badge">Beta · v{latest.version}</span>
        <h1>{site.tagline}</h1>
        <p class="lede">{site.description}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={latest.dmgUrl}>Download for macOS</a>
          <a class="btn" href={site.repoUrl} rel="noopener">View on GitHub</a>
        </div>
        <p class="hero__note">macOS 12 or later · Apple Silicon and Intel · Free</p>
      </div>
      <div class="container hero__stage"><HeroIllustration /></div>
    </section>
    <HowItWorks />
  </main>
  <Footer />
</Base>

<style>
  .hero { position: relative; overflow: clip; padding-block: clamp(4rem, 2rem + 10vw, 9rem) var(--section-y); }
  .hero::before {
    content: ''; position: absolute; inset: -20% -10% auto; height: 80%; z-index: -1;
    background: radial-gradient(40% 50% at 25% 30%, var(--mesh-a), transparent 70%), radial-gradient(35% 45% at 80% 20%, var(--mesh-b), transparent 70%);
  }
  .hero__inner { display: grid; justify-items: center; text-align: center; gap: var(--space-5); }
  h1 { font-size: var(--step-5); line-height: 1.02; letter-spacing: -0.04em; font-weight: 750; max-width: 16ch; text-wrap: balance; }
  .hero__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-3); }
  .hero__note { color: var(--muted); font-size: var(--step--1); }
  .hero__stage { margin-top: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
</style>
