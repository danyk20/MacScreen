---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLatestRelease } from '../data/release';
import { withBase } from '../data/site';
const latest = await getLatestRelease();
---
<Base title="Page not found · MacScreen">
  <Nav version={latest.version} dmgUrl={latest.dmgUrl} />
  <main id="main" class="nf">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>This page doesn’t exist.</h1>
      <p class="lede">The link may be old, or mistyped. The whole story fits on one page.</p>
      <p><a class="btn btn--primary" href={withBase()}>Back to MacScreen</a></p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf { min-height: 60vh; display: grid; align-items: center; padding-block: var(--section-y); }
  h1 { font-size: var(--step-4); letter-spacing: -0.03em; margin-bottom: var(--space-4); }
  .nf p:last-child { margin-top: var(--space-6); }
</style>
